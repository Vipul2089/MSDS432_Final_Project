# Local development settings. `make up` copies this file to .env if it is missing.
# These are local-only credentials; never put real secrets here.
# Lines starting with # are optional; uncomment one to change it. Empty or
# missing values use the defaults shown.

# Credentials

POSTGRES_USER=obs
POSTGRES_PASSWORD=obs-local
POSTGRES_DB=obs_meta

S3_ACCESS_KEY_ID=obs
S3_SECRET_ACCESS_KEY=obs-local-secret
S3_BUCKET=obsfabric

GRAFANA_ADMIN_PASSWORD=admin

# Host ports. Change one if the port is already in use on your machine.

# ROUTER_PORT=8080
# INGEST_PORT=8081
# DLM_PORT=8082
# OPENSEARCH_PORT=9200
# POSTGRES_PORT=5440
# SEAWEEDFS_PORT=8333
# PROMETHEUS_PORT=9090
# GRAFANA_PORT=3000

# Memory. Lower these if Docker has less than 8 GB.
# Keep the OpenSearch heap at about half of its container memory.

# OPENSEARCH_HEAP=1536m
# OPENSEARCH_MEMORY=3g
# Each DuckDB database in dlm; the dlm container has 512 MB.
# DLM_DUCKDB_MEMORY=256MB
# DuckDB in the router; the router container has 1 GB.
# ROUTER_DUCKDB_MEMORY=512MB

# Service settings, described in the low-level design (docs/design/lld.md, section 7.1).

# LOG_LEVEL=info
# Parser workers per file; the default is the number of CPUs.
# INGEST_WORKERS=
# INGEST_BULK_WORKERS=2
# DLM_PLAN_INTERVAL=30s
# DLM_RUN_INTERVAL=5s
# ROUTER_HOT_TIMEOUT=5s
# ROUTER_COLD_TIMEOUT=20s
# ROUTER_COLD_CONCURRENCY=4
# ROUTER_MAX_COLD_WINDOW=168h
# ROUTER_CATALOG_CACHE_TTL=5s
